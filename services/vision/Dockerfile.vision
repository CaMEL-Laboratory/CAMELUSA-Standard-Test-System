FROM nvcr.io/nvidia/l4t-pytorch:r32.7.1-pth1.10-py3

WORKDIR /app

# 设置环境变量
ENV PATH="/opt/yolo5_env/bin:$PATH"
ENV LD_LIBRARY_PATH=/opt/GeneralMVTech/MVviewer/lib/GenICam/bin:/opt/GeneralMVTech/MVviewer/lib:$LD_LIBRARY_PATH
ENV DISPLAY=:0

# 在 COPY . /app 的【前面】加上这行
COPY shape_predictor_68_face_landmarks.dat /app/shape_predictor_68_face_landmarks.dat

# 拷贝项目源码并自动适配工业相机 MVSDK 路径
COPY . /app

RUN sed -i 's|\.\./\.\./lib/libMVSDK\.so|/opt/GeneralMVTech/MVviewer/lib/libMVSDK.so|g' /app/mvsdk.py && \
    sed -i 's|MVSDKdll = cdll\.LoadLibrary.*|import os\nlib_path = "/opt/GeneralMVTech/MVviewer/lib/libMVSDK.so"\nMVSDKdll = cdll.LoadLibrary(lib_path)|g' /app/mvsdk.py

# 启动时直接用挂载进来的虚拟环境 python 运行
CMD ["/opt/yolo5_env/bin/python", "src/Yolo5IDReconOpen_Linux.py"]